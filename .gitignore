# Dependencies
node_modules/
kit/
kit/node_modules/

# Python environments & cache
venv/
.venv/
__pycache__/
*.pyc

# Local secrets & env
.env

# Backups
*.backup.*
*.bak
.profile-backups/

# Private video project scripts & one-off edit pipelines
edit_*.py
compile_*.py
dub_*.py
mix_*.py
render_*.py
*.tmp
*.log

# Media inbox & outbox (keep directory structure)
inbox/*
!inbox/.gitkeep
outbox/*
!outbox/.gitkeep
output/
references/tiktok_refs/

# Render project caches
.*_tmp/
kit/video-projects/*/renders/
kit/video-projects/*/assets/
kit/video-projects/*/.concat*.txt
kit/video-projects/*/*.wav
kit/video-projects/*/*.mp4
kit/video-projects/*/*.ass
kit/video-projects/*/*.srt

# OS / Editor junk
